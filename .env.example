# Copy to .env and adjust (scripts/setup.sh does this once). Every value has a demo default, see src/env.ts.

# Base URL in the email and SMS links. Use your LAN IP here to open answer links on a phone.
PUBLIC_URL=http://localhost:3010
# Setup generates a private 32-byte random key here. Sessions are disabled while this is empty.
ORDY_SECRET=

DATABASE_URL=postgres://ordy:ordy@localhost:5433/ordy
FHIR_BASE_URL=http://localhost:8090/fhir

MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_SERVER_NAME=klinikum.example
MATRIX_BOT_USER=ordy
MATRIX_BOT_PASSWORD=ordy-demo-2026
MATRIX_HOFER_USER=lena.hofer
MATRIX_HOFER_PASSWORD=hofer-demo-2026

# Simulated ID Austria (Keycloak, task T02)
OIDC_METADATA_URL=http://localhost:8080/realms/idaustria-sim/.well-known/openid-configuration
OIDC_CLIENT_ID=request-service
OIDC_CLIENT_SECRET=request-service-demo-2026
# Keycloak admin login, used only by `pnpm citizen`
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-demo-2026

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025

# Optional: AI fallback parser (task T22). Without a key the fallback is off. Synthetic documents only.
# ANTHROPIC_API_KEY=
AI_FALLBACK_MODEL=claude-opus-5-5
