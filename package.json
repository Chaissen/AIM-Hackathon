{
  "name": "ordy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,bot -c blue,magenta \"pnpm dev:web\" \"pnpm dev:bot\"",
    "dev:web": "next dev -p 3010",
    "dev:bot": "tsx watch --env-file-if-exists=.env src/bot/main.ts",
    "build": "next build",
    "start": "concurrently -n web,bot \"next start -p 3010\" \"pnpm bot\"",
    "bot": "tsx --env-file-if-exists=.env src/bot/main.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p services/ehvd-mock",
    "test": "tsx --test \"src/**/*.test.ts\" \"services/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "fhir:seed": "tsx --env-file-if-exists=.env scripts/seed-fhir.ts",
    "matrix:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-matrix.ts",
    "citizen": "tsx --env-file-if-exists=.env scripts/citizen.ts",
    "validate": "tsx --env-file-if-exists=.env scripts/validate.ts",
    "audit:check": "tsx --env-file-if-exists=.env scripts/audit-check.ts",
    "scenario": "tsx --env-file-if-exists=.env scripts/scenario.ts",
    "clinical-review:export": "tsx scripts/clinical-review-export.ts",
    "setup": "./scripts/setup.sh",
    "reset": "./scripts/reset.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "markdown-it": "^15.0.3",
    "matrix-widget-api": "1.20.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "openid-client": "6.8.8",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "saxes": "6.0.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/fhir": "^0.0.44",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.2"
}
