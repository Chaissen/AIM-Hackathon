access_log off;
error_log /dev/stderr crit;

map $http_upgrade $workspace_connection {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $workspace_scheme {
    default $scheme;
    http http;
    https https;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 128k;

    location / {
        proxy_pass http://${ORDY_WEB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $workspace_scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $workspace_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
    }
}
